{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/public/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "redirects": [
    { "source": "/blog-cms/admin", "destination": "/404", "permanent": false },
    { "source": "/blog-cms/admin/", "destination": "/404", "permanent": false },
    { "source": "/blog-cms/admin/:path*", "destination": "/404", "permanent": false },
    { "source": "/request-a-demo", "destination": "/contact", "permanent": true },
    { "source": "/request-a-demo/", "destination": "/contact", "permanent": true },
    { "source": "/nnr-admin", "destination": "http://wp.99ravens.ai/nnr-admin", "permanent": false },
    { "source": "/nnr-admin/:path*", "destination": "http://wp.99ravens.ai/nnr-admin/:path*", "permanent": false }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
